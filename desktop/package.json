{
  "name": "vibe-sensei-desktop",
  "version": "0.1.0",
  "description": "Vibe Sensei Desktop — AI Trading Terminal",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build:main": "esbuild main/index.ts main/preload.ts --bundle --platform=node --external:electron --external:electron-store --external:node-pty --outdir=dist/main --format=cjs",
    "build:renderer": "vite build",
    "start": "electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron-store": "^10.0.0",
    "node-pty": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^34.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.1.1"
  }
}
